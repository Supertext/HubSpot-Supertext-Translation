# Supertext Translation for HubSpot: environment variables (Railway variables in production).
# Never commit real values.

# Public HTTPS URL of this app. APP_URL/oauth/callback must be in the app's redirectUrls
# (hubspot-project/src/app/app-hsmeta.json).
APP_URL=https://hubspot-production-xxxx.up.railway.app

# From the app's Auth tab in HubSpot (Development → Projects → Supertext Translation → Auth).
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Random secret that signs session cookies (default: derived from the client secret).
SESSION_SECRET=

# PostgreSQL for accounts, language versions and jobs (the shared Railway Postgres; the database is created on first start).
# Without it, everything lives in memory only (local development).
DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/hubspot_supertext

# Optional: encrypts stored HubSpot tokens and Supertext API keys (default: derived from the client secret).
APP_ENCRYPTION_KEY=

# Optional default Supertext API key for accounts that haven't entered their own (the demo account).
# No Supertext account yet? Create one at https://www.supertext.com/person/en/account/signin
# Generate your API key at https://www.supertext.com/en/integrations/api (supertext.com → Integrations → API; requires the Admin role).
SUPERTEXT_API_KEY=

# Optional: 0 turns the version reports to Supertext's Commando Center off for every account
# (default: each account's setting "Send version information to Supertext", on by default).
SUPERTEXT_VERSION_REPORTS=

# Optional: scopes asked for at install (must match the app's requiredScopes / optionalScopes).
HUBSPOT_SCOPES=oauth content
HUBSPOT_OPTIONAL_SCOPES=cms.knowledge_base.articles.read cms.knowledge_base.articles.write

# Optional: stand-ins (tests, screenshots) instead of https://api.supertext.com/v1/, https://app.hubspot.com and https://api.hubapi.com.
SUPERTEXT_API_ENDPOINT=
HUBSPOT_APP_BASE=
HUBSPOT_API_BASE=
